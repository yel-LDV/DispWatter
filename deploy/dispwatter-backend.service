[Unit]
Description=DispWatter backend (WebSocket API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=angedl_
Group=angedl_
WorkingDirectory=/home/angedl_/Proyectos/DispWatter
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/angedl_/Proyectos/DispWatter/backend/.venv/bin/python -m backend.main
Restart=always
RestartSec=5
# El backend no debe detenerse desde el panel. Este unit solo se gestiona por systemd/CLI.
# No se usa NoNewPrivileges porque el backend necesita sudo -n para dispwatter-ctl.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
