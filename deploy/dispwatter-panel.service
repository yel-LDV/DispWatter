[Unit]
Description=DispWatter panel (static web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=angedl_
Group=angedl_
WorkingDirectory=/home/angedl_/Proyectos/DispWatter
ExecStart=/home/angedl_/Proyectos/DispWatter/backend/.venv/bin/python /home/angedl_/Proyectos/DispWatter/panel_server.py
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
