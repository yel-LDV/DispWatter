# Valores iniciales; el primer arranque genera un JWT_SECRET y ADMIN_PASSWORD aleatorios.
# El archivo backend/.env generado es privado (permisos 0600) y no debe subirse.
HOST=0.0.0.0
PORT=8765
PANEL_PORT=3000
PANEL_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=se-genera-automaticamente-en-el-primer-arranque
JWT_EXPIRE_HOURS=12
ADMIN_USER=admin
ADMIN_PASSWORD=se-genera-automaticamente-en-el-primer-arranque
DB_NAME=data.db
MAX_MESSAGE_SIZE=2048
LOG_LEVEL=INFO
