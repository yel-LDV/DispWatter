# Copia este archivo a backend/.env y cambia todos los valores.
# backend/.env nunca debe subirse al repositorio.

HOST=0.0.0.0
PORT=8765
PANEL_PORT=3000
PANEL_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secreto para firmar los tokens de sesión del panel (cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-64-caracteres
JWT_EXPIRE_HOURS=12

# Usuario administrador inicial (solo se crea si no existe ningún usuario)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena

DB_NAME=data.db
MAX_MESSAGE_SIZE=2048
LOG_LEVEL=INFO
